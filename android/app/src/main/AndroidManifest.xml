<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISOS
        ========
        Este ejemplo NO necesita READ/WRITE_EXTERNAL_STORAGE:
          * El PDF se escribe en directorios privados de la app
            (getTemporaryDirectory / getApplicationDocumentsDirectory),
            que no requieren permisos desde Android 4.4.
          * share_plus no comparte rutas "file://": copia el archivo a
            cache/share_plus y entrega una URI "content://" a través de su
            propio FileProvider (se fusiona solo desde el manifest del plugin)
            con permiso de lectura TEMPORAL para la app destino.
          * printing usa el PrintManager del sistema; "Guardar como PDF" lo
            hace el propio sistema mediante el Storage Access Framework.

        INTERNET: descomenta la línea siguiente cuando conectes un LLM real
        (Gemini, OpenAI...). En debug Flutter ya la agrega automáticamente,
        pero en release (APK firmado) debe estar aquí.
    -->
    <!-- <uses-permission android:name="android.permission.INTERNET"/> -->

    <application
        android:label="Reportes IA PDF"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
        VISIBILIDAD DE PAQUETES (Android 11 / API 30+)
        ==============================================
        Desde Android 11 una app solo "ve" las demás apps que declara aquí.
        share_plus llama a packageManager.queryIntentActivities(...) para dar
        permiso de lectura de la URI del PDF a cada app que puede recibirlo.
        Sin estas <queries> esa lista llega filtrada (casi vacía) y algunas
        apps destino no pueden abrir el archivo.
    -->
    <queries>
        <!-- Apps que aceptan recibir UN PDF (Gmail, WhatsApp, Drive...). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="application/pdf"/>
        </intent>
        <!-- Apps que aceptan VARIOS archivos (si compartes más de un PDF). -->
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE"/>
            <data android:mimeType="application/pdf"/>
        </intent>
        <!-- Requerido por el motor de Flutter (menú de texto seleccionado). -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
